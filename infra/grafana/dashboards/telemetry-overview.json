    {
      "type": "timeseries",
      "title": "Messages consumed by outcome",
      "description": "Per minute: acked, dead-lettered (poison or retries exhausted) or requeued on shutdown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue, outcome) (rate(telemetry_messaging_consumed_total[$__rate_interval])) * 60",
          "legendFormat": "{{queue}} {{outcome}}",
