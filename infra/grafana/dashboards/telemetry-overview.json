    {
      "type": "timeseries",
      "title": "Reading flow",
      "description": "Readings per minute at each stage of the pipeline.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(telemetry_ingestor_readings_published_total[$__rate_interval])) * 60",
          "legendFormat": "published by ingestor",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(telemetry_processor_readings_stored_total[$__rate_interval])) * 60",
          "legendFormat": "stored by processor",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(telemetry_notifications_readings_total[$__rate_interval])) * 60",
