{
  "uid": "telemetry-runtime",
  "title": "Service runtime",
  "description": ".NET runtime, HTTP, messaging and database metrics per microservice.",
  "tags": [
    "telemetry"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"telemetry-services\"}, service)",
          "refId": "service"
        },
        "definition": "label_values(up{job=\"telemetry-services\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Telemetry overview",
      "type": "link",
      "url": "/d/telemetry-overview",
      "icon": "dashboard"
    }
  ],
