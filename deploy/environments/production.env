INGESTOR_PORT=7101
PROCESSOR_PORT=7102
GATEWAY_PORT=7103
NOTIFICATIONS_PORT=7104
FRONTEND_PORT=7200
PROMETHEUS_PORT=9290
GRAFANA_PORT=3200
PROMETHEUS_RETENTION=30d
