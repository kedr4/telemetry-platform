# Staging: its own compose project, network, volumes and host ports, so it can share a host with
# a development stack. Secrets (passwords, API keys) are passed as environment variables by the
# pipeline and take precedence over this file.
COMPOSE_PROJECT_NAME=telemetry-staging

WEAKAPP_PORT=6080
RABBITMQ_MANAGEMENT_PORT=16672
POSTGRES_PORT=6432
INGESTOR_PORT=6101
PROCESSOR_PORT=6102
GATEWAY_PORT=6103
NOTIFICATIONS_PORT=6104
FRONTEND_PORT=6200
PROMETHEUS_PORT=9190
GRAFANA_PORT=3100
