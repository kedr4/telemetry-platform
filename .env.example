# Copy to `.env` and adjust. Every variable is optional: docker-compose.yml has development defaults.

# --- Unstable external API ---
WEAKAPP_PORT=5080
WEAKAPP_API_KEY=supersecret

# --- RabbitMQ ---
RABBITMQ_USER=telemetry
RABBITMQ_PASSWORD=telemetry
RABBITMQ_MANAGEMENT_PORT=15672

# --- PostgreSQL ---
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_PORT=5432

# --- Microservices (host ports) ---
INGESTOR_PORT=5101
PROCESSOR_PORT=5102
GATEWAY_PORT=5103
NOTIFICATIONS_PORT=5104

# --- Frontend ---
FRONTEND_PORT=4200

# --- Observability ---
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
