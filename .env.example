# Copy to `.env` and adjust. Every variable is optional: docker-compose.yml has development defaults.

# --- Unstable external API ---
WEAKAPP_PORT=5080
WEAKAPP_API_KEY=supersecret

# --- RabbitMQ ---
RABBITMQ_USER=telemetry
RABBITMQ_PASSWORD=telemetry
RABBITMQ_MANAGEMENT_PORT=15672

# --- PostgreSQL ---
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_PORT=5432
